# Copie este arquivo para ".env" (cp .env.example .env) e troque os valores.
# O arquivo .env NÃO deve ser enviado ao Git.

# Banco de dados (PostgreSQL)
# A senha não pode conter os caracteres @ : / ? # (ela entra no endereço de conexão).
POSTGRES_USER=plantaofacil
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=plantao-facil-db

# Chave usada para assinar os tokens de login (use um texto longo e aleatório)
# Exemplo para gerar: openssl rand -hex 32
JWT_SECRET=troque-esta-chave

# Validade do login, em minutos (1440 = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Conta Admin criada na primeira inicialização (só é usada se ainda não existir um Admin)
ADMIN_EMAIL=admin@plantaofacil.com
ADMIN_PASSWORD=troque-esta-senha-do-admin

# Porta em que o sistema fica disponível no servidor
HTTP_PORT=80

# Origens extras autorizadas a chamar a API, separadas por vírgula.
# Pode ficar vazio: o site e a API são servidos pelo mesmo endereço.
CORS_ORIGINS=
